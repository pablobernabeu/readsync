    given-names: Pablo
    affiliation: University of Oxford
    orcid: "https://orcid.org/0000-0003-1083-2460"
version: 0.1.0
date-released: 2026-08-26
license: MIT
repository-code: "https://github.com/pablobernabeu/readsync"
keywords:
